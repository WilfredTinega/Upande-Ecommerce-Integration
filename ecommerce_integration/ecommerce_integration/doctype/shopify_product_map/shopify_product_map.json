  {
   "fieldname": "shopify_variant_id",
   "fieldtype": "Data",
   "label": "Shopify Variant ID",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "description": "Matching key. Shopify SKUs on this store are all null, so lines are matched on variant id."
  },
  {
   "fieldname": "shopify_product_id",
   "fieldtype": "Data",
   "label": "Shopify Product ID"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "column_break_pm",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "line_class",
   "fieldtype": "Select",
   "label": "Line Class",
   "options": "Box\nFee\nPackaging\nOther",
   "default": "Box",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Only Box lines are allocated. Fee and Packaging lines are carried on the order and ignored by allocation."
  },
  {
   "fieldname": "box_item",
   "fieldtype": "Link",
   "label": "Box Item",
   "options": "Item",
   "description": "Optional ERPNext item representing this box product."
  },
  {
   "fieldname": "stems_per_box",
   "fieldtype": "Int",
   "label": "Stems per Box",
   "in_list_view": 1,
   "description": "Used to pre-fill how many stems an allocation needs. Leave 0 when the ordered qty is itself the stem count."
  },
  {
   "fieldname": "qty_is_stems",
   "fieldtype": "Check",
   "label": "Ordered Qty is Stems",
   "default": "0",
   "description": "Set for build-your-own products, where the ordered quantity is a stem count rather than a number of boxes."
  },
  {
   "fieldname": "notes_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "notes",
